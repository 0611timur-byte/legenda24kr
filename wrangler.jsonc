{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pseudolegend-telegram-bot",
  "main": "index.js",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_STATE",
        "class_name": "BotState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BotState"]
    }
  ]
}
